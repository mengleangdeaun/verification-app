# ==========================================
# Serverless Certificate Ledger Environment
# ==========================================

# Ed25519 Asymmetric Cryptographic Keypair (Base64URL)
# Generate via node:crypto or Web Crypto API
ED25519_PRIVATE_KEY_B64=
ED25519_PUBLIC_KEY_B64=

# Neon Serverless PostgreSQL Database Connection URI
# Leave empty to use local mock ledger (data/mock-ledger.json)
DATABASE_URL=postgres://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require

# Master Admin Access Token (used to access /admin and sign API requests)
ADMIN_API_SECRET=your_admin_secret_key_here

# Public Base URL for Verification QR Code links
PUBLIC_APP_URL=http://localhost:4321

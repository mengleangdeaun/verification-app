---
import '../styles/app.css';
import { assetUrl } from '../utils/paths';
interface Props { title?: string; }
const { title = "Certificate Verification Ledger" } = Astro.props;
---
<!doctype html>
<html lang="en" class="h-full bg-slate-50/60 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={assetUrl('/favicon.svg')} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-full flex flex-col text-foreground font-sans">
    <slot />
  </body>
</html>

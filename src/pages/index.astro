---
import Layout from '../layouts/Layout.astro';
import { assetUrl, appPath } from '../utils/paths';
---
<Layout title="Certificate Verification Portal">
  <main class="flex-1 flex flex-col items-center justify-center p-4 sm:p-8">
    <div class="w-full max-w-xl bg-card shadow-xl border border-border p-6 sm:p-10">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center h-16 w-16 mx-auto mb-3.5 p-2.5 bg-muted/60 border border-border shadow-xs">
          <img src={assetUrl('/assets/logo.svg')} alt="Emblem" class="h-full w-full object-contain" />
        </div>
        <h1 class="text-2xl sm:text-3xl font-serif font-bold text-foreground tracking-tight">Certificate Verification</h1>
        <p class="text-xs sm:text-sm text-muted-foreground mt-1">Authenticate Ed25519 tamper-proof credentials directly against the canonical ledger</p>
      </div>

      <form action={appPath('/check')} method="GET" class="space-y-4">
        <div class="space-y-1">
          <label for="id" class="block text-xs font-semibold text-foreground">Certificate Identifier</label>
          <input
            id="id"
            name="id"
            type="text"
            required
            placeholder="e.g. CERT-2026-8F92A1"
            class="w-full h-10 px-3.5 border border-input bg-background font-mono tabular-nums text-xs text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 transition-[border-color,box-shadow] duration-150 ease-out"
          />
        </div>
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <label for="sig" class="block text-xs font-semibold text-foreground">Ed25519 Digital Signature</label>
            <span class="text-[10px] text-muted-foreground font-mono">86 Base64URL chars</span>
          </div>
          <input
            id="sig"
            name="sig"
            type="text"
            required
            placeholder="Paste 86-character Base64URL signature..."
            class="w-full h-10 px-3.5 border border-input bg-background font-mono tabular-nums text-xs text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 transition-[border-color,box-shadow] duration-150 ease-out"
          />
        </div>
        <button
          type="submit"
          class="w-full h-11 mt-2 inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground font-semibold text-xs hover:bg-primary/90 transition-[background-color,transform,box-shadow] duration-150 ease-out active:scale-[0.97] shadow-xs cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 select-none"
        >
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Verify Authenticity
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-border flex items-center justify-center text-xs text-muted-foreground">
        <a href={appPath('/admin')} class="hover:text-foreground font-medium transition-[color] duration-150 ease-out flex items-center gap-1">
          Authorized Registrar Workspace &rarr;
        </a>
      </div>
    </div>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import VerificationPortal from '../modules/verification-scanner/components/VerificationPortal';
import { assetUrl, appPath } from '../utils/paths';

export const prerender = false;

const initialId = Astro.url.searchParams.get('id') || '';
const initialSig = Astro.url.searchParams.get('sig') || '';
const defaultMode = Astro.url.searchParams.get('mode') === 'manual' || (initialId && !Astro.url.searchParams.get('mode')) ? 'manual' : 'camera';
---
<Layout title="Certificate Verification Portal">
  <main class="flex-1 flex flex-col items-center justify-center p-4 sm:p-8">
    <div class="w-full max-w-xl bg-card border border-border p-6 sm:p-10 shadow-xs">
      <div class="text-center mb-6 sm:mb-8">
        <div class="inline-flex items-center justify-center h-16 w-auto mx-auto mb-3.5">
          <img src={assetUrl('/assets/logo.svg')} alt="s-cool" class="h-full w-full object-contain" />
        </div>
        <h1 class="text-2xl sm:text-3xl font-serif font-bold text-foreground tracking-tight">Certificate Verification</h1>
        <p class="text-xs sm:text-sm text-muted-foreground mt-1">Authenticate official credentials directly against the registry</p>
      </div>

      <VerificationPortal
        client:load
        initialId={initialId}
        initialSig={initialSig}
        defaultMode={defaultMode}
      />

      <div class="mt-8 pt-6 border-t border-border flex items-center justify-center text-xs text-muted-foreground">
        <a href={appPath('/admin')} class="hover:text-foreground font-medium transition-[color] duration-150 ease-out flex items-center gap-1">
          Authorized Registrar Workspace &rarr;
        </a>
      </div>
    </div>
  </main>
</Layout>
